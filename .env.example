# PostHog project key for this app.
# This is a publishable key: it is meant to ship in the client bundle, so it is
# not a secret. It is still read from the environment so preview/production can
# point at different PostHog projects.
#
# The ingestion host is NOT set here -- requests are proxied same-origin through
# the /ingest rewrite in next.config.mjs to survive ad blockers.
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key_here
