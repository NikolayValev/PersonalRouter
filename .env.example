# PostHog project key for this app.
# This is a publishable key: it is meant to ship in the client bundle, so it is
# not a secret. It is still read from the environment so different deployments
# can point at different PostHog projects.
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key_here

# PostHog ingestion host. Consumed by the /ingest rewrite in next.config.mjs,
# NOT passed to posthog.init -- the browser always talks to the same-origin
# /ingest proxy so ad blockers do not drop events. The matching assets host
# (us -> us-assets) is derived from this value.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
